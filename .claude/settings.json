{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/validate-w3c.sh:*)",
      "Bash(bash .claude/skills/audit-a11y.sh:*)",
      "Bash(node .claude/skills/generate-doc.js:*)",
      "Bash(node tests/run-all.mjs:*)",
      "Bash(node tests/browser/smoke.mjs:*)",
      "Bash(node tests/lib/server.mjs:*)",
      "Bash(python3 -m http.server:*)"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(bun add:*)"
    ]
  }
}
